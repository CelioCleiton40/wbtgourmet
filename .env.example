# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret
SUPABASE_SECRET_KEY=your_supabase_api_secret_key

# Mercado Pago Keys
MERCADOPAGO_ACCESS_TOKEN=APP_USR_your_access_token_here
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_signing_secret_here
MERCADOPAGO_NOTIFICATION_URL=https://your-domain.com/api/webhooks/mercadopago

# Uber Direct Credentials
UBER_DIRECT_CLIENT_ID=your_uber_client_id
UBER_DIRECT_CLIENT_SECRET=your_uber_client_secret
UBER_DIRECT_CUSTOMER_ID=your_uber_customer_id
UBER_DIRECT_WEBHOOK_SIGNING_KEY=your_uber_webhook_signing_key
UBER_DIRECT_ENVIRONMENT=sandbox

# Base URL & Cron
NEXT_PUBLIC_BASE_URL=http://localhost:3000
CRON_SECRET=your_secure_cron_secret_token
